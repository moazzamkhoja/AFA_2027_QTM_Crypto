\begin{figure}[ht]
\centering
\includegraphics[width=0.75\textwidth]{figures/fig1_conviction_returns.pdf}
\caption{Coins: mean next-month returns by conviction--valuation cell (median splits
within class-month; error bars are $\pm$1 standard error of the monthly cell means).
The conviction premium is positive only where valuation is cheap, and high-conviction
expensive coins earn the lowest returns.}
\label{fig:conviction}
\end{figure}
\efloatseparator
 
\begin{figure}[ht]
\centering
\includegraphics[width=0.85\textwidth]{figures/fig2_cumulative.pdf}
\caption{Cumulative log return of the token conviction quintile long-short (EW, top
minus bottom quintile, monthly rebalanced) against the equal-weighted token universe,
over the 50 formation months of the portfolio sample. The long-short accumulates
steadily through a period in which the token universe itself loses value.}
\label{fig:cumulative}
\end{figure}
